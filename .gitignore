# Roomflow — React/TypeScript, Convex, and native Swift capture
# Commit source code, spec.md, AGENTS.md, shared configuration, and lockfiles.

# JavaScript dependencies and package-manager caches
node_modules/
.npm/
.npm-cache/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.yarn/install-state.gz
.pnp.*

# Web build output and tool caches
dist/
build/
.vite/
.next/
out/
.turbo/
.cache/
.parcel-cache/
.eslintcache
*.tsbuildinfo

# Local environment files — commit sanitized templates only
.env
.env.*
!.env.example
!.env.*.example
!.env.template
!.env.*.template
.envrc

# Local deployment state — keep Convex source and convex/_generated tracked
.convex/
.vercel/
.netlify/
.wrangler/

# Test artifacts and coverage — keep tests and small fixtures tracked
coverage/
.nyc_output/
playwright-report/
playwright/.cache/
playwright/.auth/
test-results/
blob-report/

# Logs and process state
logs/
*.log
*.pid
*.pid.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Xcode and Swift build/user state
DerivedData/
.build/
.swiftpm/
xcuserdata/
*.xcuserstate
*.xccheckout
*.xcscmblueprint
*.hmap
*.ipa
*.dSYM
*.dSYM.zip
*.xcarchive

# Signing credentials and provisioning profiles
*.p12
*.pfx
*.mobileprovision
*.provisionprofile

# Local agent state — keep shared instructions/settings tracked
.claude/worktrees/
.claude/settings.local.json
CLAUDE.local.md
.codex/auth.json
.codex/sessions/
.codex/log/
.codex/history.jsonl
.codex/*.sqlite*
.codex/*.db*
/.worktrees/
/worktrees/

# Local editor files — allow selected shared VS Code configuration
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
*.code-workspace
*.swp
*.swo
*~

# OS metadata
.DS_Store
._*
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Python helpers and local virtual environments
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Disposable local working data (repository-root directories)
/tmp/
/temp/
/scratch/
/artifacts/
/local-data/
/private-scans/
/asset-cache/
/downloads/

# Keep deliberate application assets and fixtures trackable.
# Do NOT globally ignore JSON, photos, ZIPs, GLB/glTF, USDZ, or model files.
# Put private captures and bulk downloaded assets in the directories above.
# Keep .xcodeproj/project.pbxproj, shared schemes, workspace definitions,
# dependency lockfiles, and application Package.resolved files tracked.
