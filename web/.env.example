# Copy to web/.env.local (gitignored). Read server-side only — never prefix with VITE_.
# Without GEMINI_API_KEY the app uses the free rules tier; the Gemini tier is skipped, never faked.
GEMINI_API_KEY=
# Optional: pin a model id; otherwise the server picks the cheapest available flash-lite model.
GEMINI_MODEL=gemini-3.1-flash-lite
# Set true only after using a Cloud project with active billing; do not use
# unpaid services for private room photos. This flag is an operator attestation.
GEMINI_PAID_PROJECT=false
# Spending caps in USD.
AI_DAILY_CAP_USD=2.00
AI_CALL_CAP_USD=0.02
