{
    "env": {
      "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5"
    },
    "permissions": {
      "allow": [
        "Bash(python*)",
        "Bash(pip*)",
        "Bash(pytest*)",
        "Bash(git*)",
        "Bash(sqlite3*)",
        "Bash(redis-cli*)",
        "Bash(docker*)",
        "Bash(ollama*)"
      ],
      "deny": [
        "Bash(rm -rf /)",
        "Bash(sudo rm*)",
        "Bash(format*)"
      ]
    },
    "model": "opus",
    "enabledPlugins": {
      "ecc@ecc": true,
      "claude-mem@thedotmack": true,
      "superpowers@claude-plugins-official": true,
      "caveman@caveman": true
    },
    "outputStyle": "Explanatory",
    "effortLevel": "medium",
    "plansDirectory": ".claude/plans"
  }
  